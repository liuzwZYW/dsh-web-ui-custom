{
  "name": "@liuzw/dsh-web-ui-custom",
  "version": "1.0.2",
  "description": "Custom PWA icons and a sidebar settings gear for the DeepSeek Harness Web app. 为 DSH Web 换上自制 PWA 图标，并在侧栏账户行加一个直开设置的齿轮。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/*.png"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pwa",
    "icons",
    "sidebar",
    "settings",
    "web"
  ],
  "author": "liuzwZYW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuzwZYW/dsh-web-ui-custom.git"
  },
  "homepage": "https://github.com/liuzwZYW/dsh-web-ui-custom#readme",
  "bugs": {
    "url": "https://github.com/liuzwZYW/dsh-web-ui-custom/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
